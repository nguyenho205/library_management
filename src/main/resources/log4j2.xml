<?xml version="1.0" encoding="UTF-8"?>
<!--
  Yeu cau de bai: "Su dung log4j de dat log cho tat ca cac chuc nang (ca Request va Response),
  log duoc hien thi tren console va luu vao file".
  - Console Appender: xem log truc tiep khi chay app
  - RollingFile Appender: luu vao logs/library-app.log, tu dong xoay vong file theo ngay / theo dung luong (10MB),
    giu lai toi da 30 file nen .gz de tranh phinh dung luong dia.
-->
<Configuration status="WARN" monitorInterval="30">
    <Properties>
        <Property name="LOG_PATTERN">%d{yyyy-MM-dd HH:mm:ss.SSS} [%t] %-5level %logger{36} - %msg%n</Property>
        <Property name="LOG_DIR">logs</Property>
    </Properties>

    <Appenders>
        <Console name="Console" target="SYSTEM_OUT">
            <PatternLayout pattern="${LOG_PATTERN}"/>
        </Console>

        <RollingFile name="FileAppender"
                     fileName="${LOG_DIR}/library-app.log"
                     filePattern="${LOG_DIR}/archive/library-app-%d{yyyy-MM-dd}-%i.log.gz">
            <PatternLayout pattern="${LOG_PATTERN}"/>
            <Policies>
                <TimeBasedTriggeringPolicy interval="1" modulate="true"/>
                <SizeBasedTriggeringPolicy size="10MB"/>
            </Policies>
            <DefaultRolloverStrategy max="30"/>
        </RollingFile>

        <!-- File rieng cho log loi (ERROR) de de theo doi su co -->
        <RollingFile name="ErrorFileAppender"
                     fileName="${LOG_DIR}/library-error.log"
                     filePattern="${LOG_DIR}/archive/library-error-%d{yyyy-MM-dd}-%i.log.gz">
            <PatternLayout pattern="${LOG_PATTERN}"/>
            <Filters>
                <ThresholdFilter level="ERROR" onMatch="ACCEPT" onMismatch="DENY"/>
            </Filters>
            <Policies>
                <TimeBasedTriggeringPolicy interval="1" modulate="true"/>
                <SizeBasedTriggeringPolicy size="10MB"/>
            </Policies>
            <DefaultRolloverStrategy max="30"/>
        </RollingFile>
    </Appenders>

    <Loggers>
        <!-- Log rieng cho package cua app: muc INFO de thay ro Request/Response tu LoggingAspect -->
        <Logger name="com.fresher.library" level="INFO" additivity="false">
            <AppenderRef ref="Console"/>
            <AppenderRef ref="FileAppender"/>
            <AppenderRef ref="ErrorFileAppender"/>
        </Logger>

        <!-- Giam bot log noise cua Hibernate/Spring o muc mac dinh -->
        <Logger name="org.hibernate" level="WARN"/>
        <Logger name="org.springframework" level="WARN"/>

        <Root level="INFO">
            <AppenderRef ref="Console"/>
            <AppenderRef ref="FileAppender"/>
            <AppenderRef ref="ErrorFileAppender"/>
        </Root>
    </Loggers>
</Configuration>
