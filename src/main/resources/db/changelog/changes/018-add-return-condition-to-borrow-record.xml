<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.20.xsd">

    <changeSet id="018-add-return-condition-to-borrow-record" author="fresher-java">
        <addColumn tableName="borrow_record">
            <column name="book_condition" type="VARCHAR(30)">
                <constraints nullable="true"/>
            </column>
            <column name="damage_fee" type="DECIMAL(12,2)" defaultValueNumeric="0.00">
                <constraints nullable="true"/>
            </column>
            <column name="return_notes" type="VARCHAR(500)">
                <constraints nullable="true"/>
            </column>
            <column name="returned_by" type="VARCHAR(150)">
                <constraints nullable="true"/>
            </column>
        </addColumn>
    </changeSet>
</databaseChangeLog>
