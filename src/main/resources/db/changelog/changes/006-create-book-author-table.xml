<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.20.xsd">

    <changeSet id="006-create-book-author-table" author="fresher-java">
        <createTable tableName="book_author">
            <column name="book_id" type="BIGINT">
                <constraints nullable="false" foreignKeyName="fk_ba_book" references="book(id)"/>
            </column>
            <column name="author_id" type="BIGINT">
                <constraints nullable="false" foreignKeyName="fk_ba_author" references="author(id)"/>
            </column>
        </createTable>
        <addPrimaryKey tableName="book_author" columnNames="book_id, author_id" constraintName="pk_book_author"/>
    </changeSet>
</databaseChangeLog>
