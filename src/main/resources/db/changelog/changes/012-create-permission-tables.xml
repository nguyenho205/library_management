<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.20.xsd">

    <changeSet id="012-create-permission-tables" author="fresher-java">
        <createTable tableName="permission">
            <column name="id" type="BIGINT" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="code" type="VARCHAR(50)">
                <constraints nullable="false" unique="true"/>
            </column>
            <column name="description" type="VARCHAR(255)"/>
        </createTable>

        <createTable tableName="permission_group">
            <column name="id" type="BIGINT" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="name" type="VARCHAR(100)">
                <constraints nullable="false" unique="true"/>
            </column>
            <column name="description" type="VARCHAR(255)"/>
        </createTable>

        <createTable tableName="group_permission">
            <column name="group_id" type="BIGINT">
                <constraints nullable="false" foreignKeyName="fk_gp_group" references="permission_group(id)"/>
            </column>
            <column name="permission_id" type="BIGINT">
                <constraints nullable="false" foreignKeyName="fk_gp_permission" references="permission(id)"/>
            </column>
        </createTable>
        <addPrimaryKey tableName="group_permission" columnNames="group_id, permission_id" constraintName="pk_group_permission"/>

        <createTable tableName="account_permission_group">
            <column name="account_id" type="BIGINT">
                <constraints nullable="false" foreignKeyName="fk_apg_account" references="account(id)"/>
            </column>
            <column name="group_id" type="BIGINT">
                <constraints nullable="false" foreignKeyName="fk_apg_group" references="permission_group(id)"/>
            </column>
        </createTable>
        <addPrimaryKey tableName="account_permission_group" columnNames="account_id, group_id" constraintName="pk_account_permission_group"/>
    </changeSet>
</databaseChangeLog>
