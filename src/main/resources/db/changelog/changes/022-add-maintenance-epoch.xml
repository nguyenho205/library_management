<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.20.xsd">
    <changeSet id="022-add-maintenance-epoch" author="codex">
        <addColumn tableName="system_config">
            <column name="maintenance_epoch" type="BIGINT" defaultValueNumeric="0">
                <constraints nullable="false"/>
            </column>
        </addColumn>
        <update tableName="system_config">
            <column name="maintenance_epoch" valueNumeric="1"/>
            <where>maintenance_mode = 1</where>
        </update>
    </changeSet>
</databaseChangeLog>
