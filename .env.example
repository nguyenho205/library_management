# Copy to .env and change passwords/secrets before exposing Docker to a network.
MYSQL_USER=library
MYSQL_PASSWORD=change-this-database-password
MYSQL_ROOT_PASSWORD=change-this-root-password
APP_JWT_SECRET=replace-with-a-random-secret-of-at-least-64-bytes-before-sharing-this-project-2026
APP_DEFAULT_ADMIN_EMAIL=admin@library.local
APP_DEFAULT_ADMIN_PASSWORD=change-this-admin-password
APP_MAIL_ENABLED=false
SPRING_MAIL_HOST=smtp.gmail.com
SPRING_MAIL_PORT=587
SPRING_MAIL_USERNAME=
SPRING_MAIL_PASSWORD=
MAIL_FROM=

WEB_PORT=5173
BACKEND_PORT=8080
APP_FRONTEND_URL=http://localhost:5173

# For a physical phone, replace the IP with this computer's LAN IPv4.
# Android Emulator: set EXPO_PUBLIC_API_URL=http://10.0.2.2:8080/api
DOCKER_HOST_IP=192.168.1.25
EXPO_PUBLIC_API_URL=http://192.168.1.25:8080/api
